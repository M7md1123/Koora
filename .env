# ===== REQUIRED =====
# Discord Developer Portal -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN_HERE

# API-Football key (RapidAPI "X-RapidAPI-Key" or api-sports.io dashboard key)
API_FOOTBALL_KEY=PASTE_YOUR_API_FOOTBALL_KEY_HERE

# Discord channel ID (Developer Mode ON -> right-click channel -> Copy Channel ID)
CHANNEL_ID=PASTE_YOUR_CHANNEL_ID_HERE

# ===== OPTIONAL (defaults shown) =====
# "rapidapi" (api-football-v1.p.rapidapi.com) or "direct" (v3.football.api-sports.io)
API_PROVIDER=rapidapi

# 307 = Saudi Pro League (Roshn), 504 = King's Cup. Comma separated. Verify with /leagues?search=saudi
LEAGUE_IDS=307,504

# 23 = Saudi Arabia national team. Comma separated. Verify with /teams?search=saudi
TEAM_IDS=23

TIMEZONE=Asia/Riyadh

# Live polling schedule (every minute). Use */2 * * * * for every 2 minutes.
POLL_CRON=* * * * *

# Daily "today's matches" post (08:00 Riyadh time)
DAILY_CRON=0 8 * * *

# Refresh the cached schedule (every 2 hours)
SCHEDULE_REFRESH_CRON=0 */2 * * *

# Send a "match starts soon" reminder this many minutes before kickoff
REMINDER_MINUTES=30
